@page "/popup.html"
@inject IJSRuntime JS
@rendermode InteractiveAuto

<div id="app" class="main-container">
    <div>
        <p class="placeholder">yoai fanatic</p>
        <h3 class="tiny5-regular" style="display:inline-block; font-size:20px; margin-top:0px; margin-bottom:2px">tom_a_to</h3>
        <p class="tiny5-regular" style="display:inline-block; float:right; font-size:15px">@FormatTime(remainingTime)</p>
    </div>

    <TimeInput TotalSecondsChanged="OnTimeChanged" />

    <hr />

    <Slider Min="0" Max="@totalDuration" SliderValue="@remainingTime" Breakpoints="@breakpoints" />

    <hr />
    <button @onclick="Start" class="button-container tiny5-regular">Start</button>
    <button @onclick="Pause" class="button-container tiny5-regular">Pause</button>
    <button @onclick="Reset" class="button-container tiny5-regular">Reset</button>

    <div style="margin-bottom: 10px;">
        <input type="number" min="0" max="100" placeholder="Percentage (0-100)" class="tiny5-regular" @bind="Breakpoint"/>
        <button @onclick="AddBreakpoint" class="tiny5-regular button-container">Add Breakpoint</button>
    </div>

    @if (breakpoints.Any())
    {
        <div>
            <h4 class="tiny5-regular">Active Breakpoints:</h4>
            <ul>
                @foreach (var bp in breakpoints.OrderByDescending(b => b))
                {
                    <li class="tiny5-regular" style=" font-size:12px">@bp% (@FormatTime((int)(totalDuration * bp / 100.0)))</li>
                }
            </ul>
        </div>
    }

    <p class="placeholder">placeholder</p>
</div>

@code {
    public class TimerState
    {
        public int remaining { get; set; }
        public int total { get; set; }
        public bool isRunning { get; set; }
        public List<int> breakpoints { get; set; }
    }

    private List<int> breakpoints = new();
    private int Breakpoint;
    private int totalDuration;
    private int remainingTime;
    private int lastCheckedTime;
    private bool isRunning;
    private PeriodicTimer? uiTimer;

    protected override async Task OnInitializedAsync()
    {
        await RestoreTimer();
        StartUiLoop();
    }

    private void OnTimeChanged(int seconds)
    {
        totalDuration = seconds;
        if (!isRunning)
        {
            remainingTime = seconds;
        }
        StateHasChanged();
    }

    private async Task Start()
    {
        if (totalDuration <= 0)
            return;

        isRunning = true;
        remainingTime = totalDuration;
        lastCheckedTime = remainingTime;
        
        await JS.InvokeVoidAsync(
            "timerStorage.saveStart",
            totalDuration,
            breakpoints
        );
    }

    private async Task Pause()
    {
        isRunning = false;
        await JS.InvokeVoidAsync(
            "timerStorage.savePause",
            remainingTime,
            totalDuration,
            breakpoints
        );
    }

    private async Task Reset()
    {
        isRunning = false;
        await JS.InvokeVoidAsync("timerStorage.clear");
        remainingTime = totalDuration;
        lastCheckedTime = totalDuration;
        breakpoints.Clear(); // Clear breakpoints on reset
        StateHasChanged();
    }

    private async Task RestoreTimer()
    {
        try
        {
            var state = await JS.InvokeAsync<TimerState>("timerStorage.load");

            if (state != null && state.total > 0)
            {
                totalDuration = state.total;
                remainingTime = state.remaining;
                lastCheckedTime = state.remaining;
                isRunning = state.isRunning;
                
                if (state.breakpoints != null)
                {
                    breakpoints = state.breakpoints;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error restoring timer: {ex.Message}");
        }
    }

    private void StartUiLoop()
    {
        uiTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        _ = Task.Run(async () =>
        {
            while (await uiTimer.WaitForNextTickAsync())
            {
                if (isRunning && remainingTime > 0)
                {
                    await RestoreTimer();
                    await InvokeAsync(StateHasChanged);
                }
            }
        });
    }

    private static string FormatTime(int seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.ToString(@"hh\:mm\:ss");
    }

    private void AddBreakpoint()
    {
        if (Breakpoint > 0 && Breakpoint < 100 && !breakpoints.Contains(Breakpoint))
        {
            breakpoints.Add(Breakpoint);
            breakpoints.Sort();
            breakpoints.Reverse(); // Highest percentage first
            Breakpoint = 0;
            StateHasChanged();
        }
    }
}