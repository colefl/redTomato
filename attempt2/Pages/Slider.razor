<div style="position: relative; width: 400px; 
    display: flex;
    justify-content: center;
        align-items: center;">
    <input class="slider"
           type="range"
           min="@Min"
           max="@Max"
           value="@SliderValue"
           disabled />
    
    <!-- Breakpoint markers -->
    @foreach (var breakpoint in Breakpoints)
    {
        <div class="breakpoint-marker" style="left: @(breakpoint)%;"></div>
    }
</div>

<p class="tiny5-regular" style="margin-top:5px">@PercentDisplay% remaining</p>

<style>
    .slider {
        width: 350px;
        height: 15px;
        border-radius: 5px;
        appearance: none;
        background: linear-gradient(to right,
            #C49799 @(PercentComplete)%,
            #BFB6BB @(PercentComplete)%);
    }
    
    .breakpoint-marker {
        position: absolute;
        top: 0;
        width: 5px;
        height: 15px;
        background-color: #A5D8FF;
        transform: translateX(-50%);
        pointer-events: none;
        border-radius: 5px;
        z-index: 10;
    }
</style>

@code {
    [Parameter] public int Min { get; set; } = 0;
    [Parameter] public int Max { get; set; }
    [Parameter] public int SliderValue { get; set; }
    [Parameter] public List<int> Breakpoints { get; set; } = new();

    private double PercentComplete =>
        Max == 0 ? 0 : ((double)SliderValue / Max) * 100;

    private string PercentDisplay => PercentComplete.ToString("0.0");

    protected override bool ShouldRender()
    {
        return true;
    }
}