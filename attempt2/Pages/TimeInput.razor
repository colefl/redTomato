@rendermode InteractiveAuto
<input type="number" style="width:70px" class="tiny5-regular" placeholder="Hours" min="0" 
       @bind-value="Hours" 
       @bind-value:event="oninput" 
       @bind-value:after="NotifyParent" />

<input type="number" style="width:70px" class="tiny5-regular" placeholder="Minutes" min="0" max="59" 
       @bind-value="Minutes" 
       @bind-value:event="oninput" 
       @bind-value:after="NotifyParent" />

<input type="number" style="width:70px" class="tiny5-regular" placeholder="Seconds" min="0" max="59" 
       @bind-value="Seconds" 
       @bind-value:event="oninput" 
       @bind-value:after="NotifyParent" />


@code {
    private int? Hours;
    private int? Minutes;
    private int? Seconds;

    [Parameter]
    public EventCallback<int> TotalSecondsChanged { get; set; }

    private async Task NotifyParent()
    {
        int total =
            (Hours ?? 0) * 3600 +
            Math.Clamp(Minutes ?? 0, 0, 59) * 60 +
            Math.Clamp(Seconds ?? 0, 0, 59);

        await TotalSecondsChanged.InvokeAsync(total);
    }
}