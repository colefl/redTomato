@page "/popup.html"
@inherits BasePage

<h1 style="width:600px">hi there I'm of a larger width</h1>
<Slider Min="0" Max="100" @bind-SliderValue="sliderValue" />

<button @onclick="StartTimer">Start</button>
<button @onclick="StopTimer">Stop</button>
<button @onclick="ResetTimer">Reset</button>

    <div>
        <Alarm @bind-TimerValue="totalTime"/>
        <button @onclick="UpdateTimer"> debug </button>
    </div>
<p> Timer: @timeSpan.ToString(@"hh\:mm\:ss")</p>
<p> total time: @totalTime.ToString()</p>

@code {

   [Parameter]
   public EventCallback<ChangeEventArgs> SliderValueChanged { get; set; }

   [Parameter]
   public EventCallback<ChangeEventArgs> TimerValueChanged { get; set; }

   [Parameter]
   public int TimerValue {get; set; }

   [Parameter]
    public int Hours {get; set; } //Is this being bound to the instances Hours?

    [Parameter]
    public int Minutes {get; set; }

    [Parameter]
    public int Seconds {get; set; }


    public int sliderValue = 100;
    public int totalTime = 0;
    //public Alarm alarm;
    private TimeSpan timeSpan;
    private DateTime startTime;
    private Timer timer;
    private bool isRunning = false;

    private void StartTimer(){
        if(!isRunning){
            startTime = DateTime.Now; //The time is now billions must do nothing
            timer = new Timer(UpdateTime, null, 0, 1000);
            isRunning = true;
            totalTime = Hours + Minutes + Seconds;
        }
    }

    private void StopTimer(){
        if(isRunning){
            timer?.Dispose();
            isRunning = false;
        }
    }

    private void ResetTimer(){
        StopTimer();
        timeSpan = TimeSpan.Zero;
    }

    private void UpdateTime(object state){
        timeSpan = DateTime.Now - startTime;
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTimer(object state){
        totalTime = (Hours * 3600) + (Minutes * 60) + Seconds;
        //totalTime = (int)alarm.calcTotalTime();
        InvokeAsync(StateHasChanged);
    }
}
