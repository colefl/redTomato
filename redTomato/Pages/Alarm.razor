<div class="alarm"
    hours="@Hours"
    minutes="@Minutes"
    seconds="@Seconds"
    @bind="@totalTime"
    @bind:event="onInput">

<p>Hours: </p> <input type="input" @onInput="calcTotalTime" @bind="@Hours"/>
<p>Minutes: </p> <input type="input" @onInput="calcTotalTime" @bind="@Minutes"/>
<p>Seconds: </p> <input type="input" @onInput="calcTotalTime" @bind="@Seconds"/>

</div>
    
<p> Seconds total: @totalTime</p>


<style>
</style>

@code {

    private int totalTime;

    [Parameter]
    public int Hours {get; set; } //Is this a getter and setter?

    [Parameter]
    public int Minutes {get; set; }

    [Parameter]
    public int Seconds {get; set; }

    [Parameter]
    public int TimerValue {get; set; }

    [Parameter]
    public EventCallback<int> TimerValueChanged {get; set; }

    public void calcTotalTime(){
        totalTime = (Hours * 3600) + (Minutes * 60) + Seconds;
        InvokeAsync(StateHasChanged);
    }
}