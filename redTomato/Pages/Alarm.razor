<input class="alarm"
    type="input"
    hours="@Hours"
    minutes="@Minutes"
    seconds="@Seconds"
    @bind="@totalTime"
    @bind:event="onInput"/>
    
<p> Timer: @totalTime</p>

<style>
</style>

@code {
    [Parameter]
    public int Hours {get; set; } //Is this a getter and setter?

    [Parameter]
    public int Minutes {get; set; }

    [Parameter]
    public int Seconds {get; set; }

    [Parameter]
    public EventCallback<int>TimerChanged {get; set; }

    private int totalTime;
}